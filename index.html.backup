<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio OS</title>
  <meta name="description" content="An interactive, terminal-first developer portfolio">
  <link rel="canonical" href="https://yourdomain.com">
  <meta property="og:title" content="Portfolio OS">
  <meta property="og:description" content="An interactive, terminal-first developer portfolio">
  <meta property="og:image" content="assets/og-image.png">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Portfolio OS">
  <meta name="twitter:description" content="An interactive, terminal-first developer portfolio">
  <meta name="twitter:image" content="assets/og-image.png">
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png">
  <link rel="manifest" href="manifest.json">
  <link rel="stylesheet" href="css/style.css">
</head>
<body style="margin:0;padding:0;background:#050505;color:#F5F5F5;font-family:monospace;">
  <div id="boot" style="position:fixed;inset:0;background:#000;display:flex;align-items:center;justify-content:center;flex-direction:column;z-index:9999;">
    <div class="boot-logo" id="boot-logo" style="white-space:pre;font-size:11px;line-height:1.1;color:#00FF88;margin-bottom:24px;"></div>
    <div class="boot-lines" id="boot-lines" style="width:min(560px,86vw);font-size:13px;color:#999999;min-height:170px;"></div>
    <div class="bar-wrap" style="width:min(560px,86vw);height:6px;background:#111;border-radius:3px;margin-top:18px;overflow:hidden;border:1px solid rgba(0,255,136,0.18);">
      <div class="bar" id="boot-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#00FF88,#00D9FF);"></div>
    </div>
    <div class="boot-pct" id="boot-pct" style="margin-top:10px;font-size:12px;color:#999999;">0%</div>
    <div class="access" id="boot-access" style="margin-top:14px;font-size:15px;letter-spacing:2px;color:#00FF88;opacity:0;"></div>
  </div>

  <!-- FX Layers -->
  <div id="fx-scanlines" style="position:fixed;inset:0;pointer-events:none;z-index:40;mix-blend-mode:overlay;background:repeating-linear-gradient(to bottom, rgba(255,255,255,0.035) 0px, rgba(255,255,255,0.035) 1px, transparent 2px, transparent 3px);opacity:.5;"></div>
  <div id="fx-vignette" style="position:fixed;inset:0;pointer-events:none;z-index:41;box-shadow: inset 0 0 180px rgba(0,0,0,.75);"></div>
  <div id="fx-grain" style="position:fixed;inset:0;pointer-events:none;z-index:42;opacity:.05;background-image:url(&quot;data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>&quot;);"></div>
  <canvas id="fx-particles" style="position:fixed;inset:0;pointer-events:none;z-index:1;"></canvas>

  <!-- Main App -->
  <div id="app" style="position:fixed;inset:0;display:flex;flex-direction:column;opacity:0;transition:opacity .5s;z-index:2;">
    <!-- Top Bar -->
    <div id="topbar">
      <div class="dots">
        <div class="dot r"></div>
        <div class="dot y"></div>
        <div class="dot g"></div>
      </div>
      <div class="title">portfolio-os — ~/terminal</div>
      <div class="spacer"></div>
      <div class="clock" id="topbar-clock"></div>
      <div class="sync">
        <div class="led"></div>
        <span>SYNC</span>
      </div>
    </div>

    <!-- Body Row: Sidebar + Main -->
    <div id="body-row">
      <!-- Sidebar -->
      <div id="sidebar">
        <div class="brand">
          <img src="assets/icon-192.png" alt="icon">
          <div>
            <div class="n">Portfolio OS</div>
            <div class="r">v1.0</div>
          </div>
        </div>
        <div class="nav-item" data-win="home">Home <span class="k">⌘1</span></div>
        <div class="nav-item" data-win="about">About <span class="k">⌘2</span></div>
        <div class="nav-item" data-win="projects">Projects <span class="k">⌘3</span></div>
        <div class="nav-item" data-win="skills">Skills <span class="k">⌘4</span></div>
        <div class="nav-item" data-win="experience">Experience <span class="k">⌘5</span></div>
        <div class="nav-item" data-win="education">Education <span class="k">⌘6</span></div>
        <div class="nav-item" data-win="certifications">Certifications</div>
        <div class="nav-item" data-win="achievements">Achievements</div>
        <div class="nav-item" data-win="opensource">Open Source</div>
        <div class="nav-item" data-win="github">GitHub</div>
        <div class="nav-item" data-win="blog">Blog</div>
        <div class="nav-item" data-win="resume">Resume</div>
        <div class="nav-item" data-win="contact">Contact</div>
        <div class="divider"></div>
        <div class="nav-item" data-win="sysmon">System Monitor</div>
        <div class="nav-item" data-win="settings">Settings</div>
        <div class="divider"></div>
        <div class="nav-item" data-win="game-snake">🎮 Snake</div>
        <div class="nav-item" data-win="game-typing">⌨️ Typing Test</div>
      </div>

      <!-- Main Content Area -->
      <div id="main">
        <!-- Home / Terminal Window -->
        <div id="win-home" class="window active" id="term-window">
          <div id="terminal"></div>
          <div id="terminal-input-row">
            <span class="prompt-label">➜</span>
            <input type="text" id="terminal-input" autocomplete="off" spellcheck="false" autofocus>
          </div>
        </div>

        <!-- About Window -->
        <div id="win-about" class="window"></div>

        <!-- Projects Window -->
        <div id="win-projects" class="window"></div>

        <!-- Skills Window -->
        <div id="win-skills" class="window"></div>

        <!-- Experience Window -->
        <div id="win-experience" class="window"></div>

        <!-- Education Window -->
        <div id="win-education" class="window"></div>

        <!-- Certifications Window -->
        <div id="win-certifications" class="window"></div>

        <!-- Achievements Window -->
        <div id="win-achievements" class="window"></div>

        <!-- Open Source Window -->
        <div id="win-opensource" class="window"></div>

        <!-- GitHub Window -->
        <div id="win-github" class="window"></div>

        <!-- Blog Window -->
        <div id="win-blog" class="window"></div>

        <!-- Resume Window -->
        <div id="win-resume" class="window"></div>

        <!-- Contact Window -->
        <div id="win-contact" class="window"></div>

        <!-- System Monitor Window -->
        <div id="win-sysmon" class="window"></div>

        <!-- Settings Window -->
        <div id="win-settings" class="window"></div>

        <!-- Snake Game Window -->
        <div id="win-game-snake" class="window"></div>

        <!-- Typing Test Window -->
        <div id="win-game-typing" class="window"></div>
      </div>
    </div>

    <!-- Status Bar -->
    <div id="statusbar">
      <div class="item">READY</div>
      <div class="spacer"></div>
      <div class="item">Press <span class="accent">Ctrl+K</span> for command palette</div>
    </div>
  </div>

  <!-- Command Palette Overlay -->
  <div id="palette-overlay">
    <div id="palette">
      <input type="text" id="palette-input" placeholder="Type a command or jump to a section...">
      <div class="results" id="palette-results"></div>
    </div>
  </div>

  <!-- Matrix Rain Overlay -->
  <div id="matrix-overlay">
    <canvas id="matrix-canvas"></canvas>
    <div class="hint">Press ESC to exit</div>
  </div>

  <!-- Hack Simulation Overlay -->
  <div id="hack-overlay">
    <div class="redflash"></div>
    <div class="hacklog" id="hack-log"></div>
    <div class="glitchtitle">SYSTEM BREACHED</div>
    <div class="reveal" id="hack-reveal">
      <h2>Just kidding. 😄</h2>
      <p>This was a theatrical "hack" simulation — purely CSS/JS fun. No actual system access occurred, no data was collected. Your browser is safe.</p>
      <div class="hint">Press ESC or click anywhere to exit</div>
    </div>
  </div>

  <script src="js/config.js"></script>
  <script>
    // Set boot logo immediately after config loads
    const bootLogo = document.getElementById('boot-logo');
    if (bootLogo && typeof CONFIG !== 'undefined' && CONFIG.asciiLogo) {
      bootLogo.textContent = CONFIG.asciiLogo;
    }
  </script>
  <script src="js/github.js"></script>
  <script src="js/effects.js"></script>
  <script src="js/terminal.js"></script>
  <script src="js/app.js"></script>
  <script>
    // Register service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('service-worker.js').catch(() => {});
    }
  </script>
</body>
</html>
